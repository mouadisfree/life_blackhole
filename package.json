{
  "name": "life-blackhole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm test:tz",
    "data:download": "mkdir -p data/raw && curl -fSL -o data/raw/WPP2024_Life_Table_Abridged_Medium_2024-2100.csv.gz \"https://population.un.org/wpp/assets/Excel%20Files/1_Indicator%20(Standard)/CSV_FILES/WPP2024_Life_Table_Abridged_Medium_2024-2100.csv.gz\"",
    "data:build": "node scripts/build-life-tables.ts && prettier --write data/life-tables.json",
    "test:tz": "TZ=Pacific/Chatham vitest run && TZ=America/St_Johns vitest run",
    "icons": "node scripts/generate-icons.ts",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.2",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer-core": "25.13.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
